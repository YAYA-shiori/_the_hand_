# Files excluded when creating network update files (updates2.dau), gitignore syntax.
# Starts from the .narignore rules; later lines can add or re-include files.
include:.narignore

# delete.txt is needed by network updates
!/delete.txt

# The balloon that comes with the nar is installed to balloon/ by SSP; a network update would only
# put its files into a folder inside the ghost folder. It has its own update files (homeurl in its
# descript.txt), which .github/scripts/build-site.ps1 makes from install.txt.
/minbal/
